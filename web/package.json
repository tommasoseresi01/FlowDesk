{
  "name": "flowdesk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "vite --mode local",
    "dev": "vite --mode development",
    "quality": "vite --mode quality",
    "production": "vite --mode production",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test": "vitest run",
    "build": "tsc && vite build --mode production",
    "build:quality": "tsc && vite build --mode quality --outDir ./dist/quality",
    "build:production": "tsc && vite build --mode production --outDir ./dist/production",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@azure/msal-browser": "^3.9.0",
    "@azure/msal-react": "^2.0.11",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@mui/icons-material": "^5.15.12",
    "@mui/material": "^5.15.10",
    "@mui/x-date-pickers": "^6.19.4",
    "admin-lte": "^3.2.0",
    "classnames": "^2.5.1",
    "date-fns": "^3.3.1",
    "i18next": "23.7.18",
    "material-react-table": "^2.11.3",
    "react": "18.2.0",
    "react-bootstrap": "^1.6.1",
    "react-dom": "18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.51.0",
    "react-i18next": "14.0.1",
    "react-modal": "^3.16.1",
    "react-router-dom": "6.21.3",
    "react-toastify": "10.0.3"
  },
  "devDependencies": {
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "4.2.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.2.0",
    "typescript": "5.3.3",
    "vite": "5.0.12",
    "vitest": "^2.1.9"
  }
}
